PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/movie_event_booking
FRONTEND_URL=http://localhost:5173

# Supabase project credentials (required for signup/login and protected APIs)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay credentials (required for checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudflare R2 uploads (optional until uploads are used)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email settings (optional in development; uses simulated/Ethereal mail if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CineVerse <tickets@cineverse.com>"

# SMS & WhatsApp settings via Twilio (optional in development; simulated if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
