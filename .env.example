# Copy to backend/.env. Never commit populated environment files.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/movie_event_booking
FRONTEND_URL=http://localhost:5173

# Supabase authentication verification credentials (server only; never use a VITE_ prefix)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy Supabase service role key is still accepted by the backend:
# SUPABASE_SERVICE_ROLE_KEY=
# Optional only when using a separate JWT/JWKS verifier:
SUPABASE_JWKS_URL=

# Razorpay credentials (required for checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: only needed if you choose to enable the existing refund webhook handler.
# Checkout does not require webhooks.
# RAZORPAY_WEBHOOK_SECRET=

# Brevo transactional email (server only; use a verified sender in Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CineVerse

# Booking SMS & WhatsApp delivery via Twilio (server only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_CONTENT_SID=
# Comma-separated placeholders in the exact order required by that Content SID.
# Allowed fields: bookingId,title,venue,dateTime,items,amount,ticketUrl
TWILIO_WHATSAPP_TEMPLATE_FIELDS=
# Trial only: set to a Twilio-provided name, e.g. sms_order_confirmation.
# Leave blank on upgraded accounts to send the full booking details.
TWILIO_SMS_TRIAL_TEMPLATE=

# Cloudflare R2 uploads (optional until uploads are used)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
